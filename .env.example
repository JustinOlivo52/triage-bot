# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

# ─── Anthropic (required — pipeline) ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Voyage (optional — upgrades retrieval from lexical to semantic search) ────
VOYAGE_API_KEY=

# ─── Backend service (backend/core/config.py) ──────────────────────────────────
# Defaults to a local SQLite file if unset. Point at a real Postgres instance
# in any shared/hosted deployment.
DATABASE_URL=sqlite:///./triage_bot.db

# No safe default — the backend refuses to start without this set (except
# under pytest, where a fixed test-only key is generated automatically).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# The Streamlit client's origin, so the backend's CORS policy allows it.
CORS_ORIGINS=http://localhost:8501

# Seeds fixed demo accounts (demo_nurse/demo_physician/demo_admin) and the
# committed patient cohort into the database on startup — idempotent, safe
# to leave on. See README.md's Auth & Roles section for the demo password.
DEMO_MODE=false
DEMO_ACCOUNT_PASSWORD=demo1234

# ─── Streamlit client (main.py / api_client.py) ────────────────────────────────
# Where main.py sends its API calls. Must point at wherever backend/main.py
# (uvicorn) is actually running.
BACKEND_API_URL=http://localhost:8000
