# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Patient Data (PHI) ───────────────────────────────────────────────────────
memory/patient_store.json

# ─── Clinical Reference ───────────────────────────────────────────────────────
# data/ is intentionally NOT ignored. The clinical reference, its precomputed
# embedding index, and the seeded demo cohort are all committed so the app runs
# with no build step. Third-party guideline PDFs are excluded: verify licensing
# before adding any document to a public repository.
data/*.pdf

# ─── Backend local dev database ───────────────────────────────────────────────
# The real deployment target is Postgres (DATABASE_URL). SQLite files here are
# local dev/scratch only — schema lives in backend/alembic/versions/, not here.
*.db
*.db-journal

# ─── Eval harness results ──────────────────────────────────────────────────────
# Each run costs real API money (evals/runner.py) and produces timestamped
# scratch output, not meant to be committed automatically. Commit a specific
# result deliberately if/when it becomes the number the README cites.
evals/results/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Streamlit ────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
